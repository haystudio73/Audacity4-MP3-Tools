;nyquist plug-in
;version 4
;type tool
;name "Suno URL Import"
;author "Suno Audacity Importer"
;release 0.3.0
;copyright "GPL-3.0; see LICENSE"
;debugbutton false
;preview disabled

;; Generated by install.py; communication is plain text, never evaluated code.
(setf bridge "@RUNTIME@/")
(defun suno-error (message)
  ;; Return a message to Audacity instead of raising a hidden Lisp exception.
  (throw 'suno-failure (format nil "Error~%~a" message)))
(defun suno-timestamp (line)
  ;; Parse digits only; never evaluate Lisp read from the bridge directory.
  (let ((value 0))
    (if (and line (= (length line) 10))
        (dotimes (i (length line))
          (let ((digit (- (char-code (char line i)) 48)))
            (setf value (if (and value (>= digit 0) (<= digit 9))
                            (+ (* value 10) digit) nil))))
        (setf value nil))
    value))
(defun suno-check-helper (session)
  (let ((pulse (open (strcat bridge "heartbeat.txt") :direction :input)) token stamp)
    (unless pulse
      (suno-error "Helper is not running or needs an update. Open Start Suno Helper.vbs, then try again."))
    (setf token (read-line pulse))
    (setf stamp (suno-timestamp (read-line pulse)))
    (close pulse)
    (unless (and token (string-equal token session) stamp
                 (>= (- (get-real-time) stamp) -1)
                 (< (- (get-real-time) stamp) 4))
      (suno-error "Helper is not responding. Open or restart Start Suno Helper.vbs, then try again."))))
(defun suno-submit ()
  (let ((live (open (strcat bridge "session.txt") :direction :input)) session out)
    (unless live (suno-error "Helper is not running. Open Start Suno Helper.vbs, then select Suno URL Import again."))
    (setf session (read-line live))
    (close live)
    (unless (and session (> (length session) 10))
      (suno-error "Helper is not ready. Open Start Suno Helper.vbs, then try again."))
    (suno-check-helper session)
    (let ((busy (open (strcat bridge "busy.txt") :direction :input)))
      (when busy (close busy) (suno-error "Helper is busy. Wait for the current download/import.")))
    (let ((pending (open (strcat bridge "request.txt") :direction :input)))
      (when pending (close pending) (suno-error "A request is pending. Check Suno Import Helper.")))
    (setf out (open (strcat bridge "request.txt") :direction :output))
    (unless out (suno-error "Cannot write request. Run install.py again."))
    (format out "SUNO-OPEN-1~%~a~%OPEN~%END~%" session)
    (close out)
    ;; An empty string is the documented successful no-op result for a tool.
    ""))
(catch 'suno-failure (suno-submit))
